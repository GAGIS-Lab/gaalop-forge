# Build with an artifact-only context (see docs/docker-release.md).
ARG QRA_BUILD_IMAGE=gaalop-qra-jammy:1.1.0
FROM ${QRA_BUILD_IMAGE} AS qra
FROM gagislab/gaalop-forge@sha256:43c7f3e487b8762da571a3b3586312e62a5eba20901dcb6a35dca081cf671211

USER root
ARG SOURCE_REVISION
LABEL org.opencontainers.image.version="1.1.0" \
      org.opencontainers.image.source="https://github.com/GAGIS-Lab/gaalop-forge" \
      org.opencontainers.image.revision="$SOURCE_REVISION"
COPY --from=qra /native/ /app/nativeLibraries/garamon/
COPY gaalop-rest.jar /app/gaalop-rest.jar
COPY frontend/ /usr/share/nginx/html/
COPY start-container.sh /app/start-container.sh
COPY nginx.conf /etc/nginx/nginx.conf
COPY licenses/ /app/licenses/
RUN chmod +x /app/start-container.sh \
    && chown -R gaalop:gaalop /app /usr/share/nginx/html
USER gaalop
