// Adapted from the supplied Qra7Project/qra7_java_bridge.cpp.
#include <algorithm>
#include <vector>
#include <utility>
#include "qra@N@/Mvec.hpp"
#ifdef _WIN32
#define QRA_API extern "C" __declspec(dllexport)
#else
#define QRA_API extern "C" __attribute__((visibility("default")))
#endif
static constexpr int SIZE = 1 << qra@N@::algebraDimension;
static qra@N@::Mvec<double> from_dense(const double* x) {
    qra@N@::Mvec<double> mv;
    for (int i = 0; i < SIZE; ++i) if (x[i] != 0.0) mv[i] = x[i];
    return mv;
}
static void to_dense(const qra@N@::Mvec<double>& mv, double* out) {
    for (int i = 0; i < SIZE; ++i) out[i] = mv[i];
}
QRA_API int qra@N@_dimension() { return qra@N@::algebraDimension; }
QRA_API int qra@N@_coeff_count() { return SIZE; }
static int population(unsigned x) { int n=0; while(x) { x &= x-1; ++n; } return n; }
// QRA's metric is positive diagonal. Sparse blade products are signed XORs.
// Avoid entering grade-dense recursive kernels for sparse high-dimensional states.
static bool sparse_product(const double* a, const double* b, double* out, int kind) {
    std::vector<std::pair<unsigned,double>> left, right;
    for(int i=0;i<SIZE;++i) {
        if(a[i]!=0) left.emplace_back(i,a[i]);
        if(b[i]!=0) right.emplace_back(i,b[i]);
    }
    if(left.size()*right.size() > 1048576u) return false;
    std::fill(out,out+SIZE,0.0);
    for(const auto& x:left) for(const auto& y:right) {
        const unsigned result=x.first^y.first;
        if(kind==1 && (x.first&y.first)) continue;
        if(kind==2 && (!x.first || !y.first || population(result)!=std::abs(population(x.first)-population(y.first)))) continue;
        unsigned mask=x.first; int parity=0;
        while(mask) { unsigned bit=mask & (~mask+1); parity ^= population(y.first & (bit-1)) & 1; mask ^= bit; }
        out[result]+=(parity ? -1 : 1)*x.second*y.second;
    }
    return true;
}
QRA_API int qra@N@_outer_dense(const double* a, const double* b, double* out) {
    if (!a || !b || !out) return -2;
    try { if(sparse_product(a,b,out,1)) return 0; auto c = from_dense(a) ^ from_dense(b); to_dense(c, out); return 0; }
    catch (...) { return -1; }
}
QRA_API int qra@N@_inner_dense(const double* a, const double* b, double* out) {
    if (!a || !b || !out) return -2;
    try { if(sparse_product(a,b,out,2)) return 0; auto c = from_dense(a) | from_dense(b); to_dense(c, out); return 0; }
    catch (...) { return -1; }
}
QRA_API int qra@N@_geometric_dense(const double* a, const double* b, double* out) {
    if (!a || !b || !out) return -2;
    try { if(sparse_product(a,b,out,0)) return 0; auto c = from_dense(a) * from_dense(b); to_dense(c, out); return 0; }
    catch (...) { return -1; }
}
